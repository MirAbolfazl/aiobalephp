{
  "name": "aiobale/aiobale-php",
  "description": "Asynchronous PHP client for the Bale messaging API",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/MirAbolfazl/aiobalephp",
  "authors": [
    {
      "name": "Abolfazl",
      "homepage": "https://github.com/MirAbolfazl"
    }
  ],
  "require": {
    "php": "^8.2",
    "amphp/amp": "^3.0",
    "amphp/http-client": "^5.0",
    "amphp/websocket-client": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Aiobale\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aiobale\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "find src tests example -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
